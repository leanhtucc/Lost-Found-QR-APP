# ======================================
# 🔒 SENSITIVE - DO NOT COMMIT
# ======================================
# This file contains sensitive environment variables
# Make sure this file is listed in .gitignore

# API Configuration
API_URL=http://localhost:3000
ENV=development
APP_ENV=development
# Android emulator: http://10.0.2.2:<port>. Physical device: private LAN IP.
# Public remote development backends require explicit acknowledgement.
ALLOW_REMOTE_DEV_API=false
API_KEY=your-dev-api-key-here

# Firebase Configuration (Development)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:android:abc123

# Other Services
SENTRY_DSN=
ANALYTICS_ID=

# App Configuration
DEBUG_MODE=true

# Client error reporting uses Sentry. Never place bot/server secrets in EXPO_PUBLIC_* values.

API_URL=
GOOGLE_MAPS_API_KEY=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
ENVFILE=
ALLOW_REMOTE_DEV_API=
